        {
          "name": "Vehicle Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Visualization Script",
                  "// Visualization Script",
                  "const template = `",
                  "<div style=\"font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; padding: 12px;\">",
                  "  <h3 style=\"margin: 0 0 12px 0; font-weight: 600;\">Vehicle Status Visualization</h3>",
                  "  {{#if error}}",
                  "    <div style=\"padding:10px; background:#fff4e5; color:#8a6100; border:1px solid #ffe0b3; border-radius:6px;\">{{error}}</div>",
                  "  {{else}}",
                  "    <div style=\"display:flex; gap:20px; flex-wrap:wrap; align-items:flex-start;\">",
                  "      <div style=\"flex:1 1 380px; min-width:300px;\">",
                  "        <canvas id=\"speedChart\" height=\"160\"></canvas>",
                  "      </div>",
                  "      <div style=\"flex:1 1 260px; min-width:220px;\">",
                  "        <div style=\"margin-bottom:8px; font-size:14px; color:#555;\">Vehicle: <strong>{{vehicleId}}</strong></div>",
                  "        <div style=\"display:flex; flex-direction:column; gap:8px;\">",
                  "          {{#each flags}}",
                  "            <div style=\"display:flex; align-items:center; gap:10px;\">",
                  "              <span style=\"width:110px; color:#333; font-size:13px; text-transform:capitalize;\">{{label}}</span>",
                  "              {{#if isBoolean}}",
                  "                <span style=\"display:inline-block; padding:4px 10px; border-radius:12px; font-size:12px; font-weight:600; color: {{colorText}}; background: {{colorBg}}; border: 1px solid {{colorBorder}};\">{{valueText}}</span>",
                  "              {{else}}",
                  "                <div style=\"flex:1; height:10px; background:#eee; border-radius:6px; position:relative;\">",
                  "                  <div style=\"position:absolute; left:0; top:0; bottom:0; width: {{percent}}%; background: #4a90e2; border-radius:6px;\"></div>",
                  "                </div>",
                  "                <span style=\"min-width:36px; text-align:right; font-size:12px; color:#555;\">{{rawValue}}</span>",
                  "              {{/if}}",
                  "            </div>",
                  "          {{/each}}",
                  "        </div>",
                  "      </div>",
                  "    </div>",
                  "  {{/if}}",
                  "</div>",
                  "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js\"></script>",
                  "<script>",
                  "  pm.getData(function (err, data) {",
                  "    if (err || !data || data.error) { return; }",
                  "    var ctx = document.getElementById('speedChart');",
                  "    if (!ctx) { return; }",
                  "    var chart = new Chart(ctx, {",
                  "      type: 'bar',",
                  "      data: {",
                  "        labels: data.chart.labels,",
                  "        datasets: [{",
                  "          label: 'Value',",
                  "          data: data.chart.values,",
                  "          backgroundColor: ['#4a90e2', '#7ed321'],",
                  "          borderColor: ['#2f6fbf', '#5aa80f'],",
                  "          borderWidth: 1",
                  "        }]",
                  "      },",
                  "      options: {",
                  "        legend: { display: false },",
                  "        title: { display: true, text: 'Speed vs Limit' },",
                  "        scales: {",
                  "          yAxes: [{ ticks: { beginAtZero: true } }]",
                  "        },",
                  "        tooltips: { enabled: true }",
                  "      }",
                  "    });",
                  "  });",
                  "</script>`;",
                  "",
                  "function coerceBoolean(value) {",
                  "    if (value === true) return { text: 'true', bg: '#e6f4ea', border: '#a3d9b1', textColor: '#1b5e20' };",
                  "    if (value === false) return { text: 'false', bg: '#fdecea', border: '#f5c6cb', textColor: '#7f1d1d' };",
                  "    return { text: 'unknown', bg: '#eef2ff', border: '#c7d2fe', textColor: '#1e3a8a' };",
                  "}",
                  "",
                  "function safeNumber(n, fallback) {",
                  "    return (typeof n === 'number' && isFinite(n)) ? n : fallback;",
                  "}",
                  "",
                  "function createPayload() {",
                  "    let json = null;",
                  "    try { json = pm.response.json(); } catch (e) { }",
                  "",
                  "    if (!json || typeof json !== 'object') {",
                  "        return { error: 'Response is not valid JSON. Cannot render visualization.' };",
                  "    }",
                  "",
                  "    // Extract values with fallbacks",
                  "    const vehicleId = (json && json.vehicleId) ? String(json.vehicleId) : 'N/A';",
                  "    const speed = safeNumber(json && json.speed, null);",
                  "    const flags = (json && json.statusFlags) ? json.statusFlags : {};",
                  "    const speedLimitFromFlags = safeNumber(flags && flags.speedLimit, null);",
                  "",
                  "    // Chart data for numeric values",
                  "    const labels = [];",
                  "    const values = [];",
                  "    if (speed !== null) { labels.push('speed'); values.push(speed); }",
                  "    if (speedLimitFromFlags !== null) { labels.push('speedLimit'); values.push(speedLimitFromFlags); }",
                  "",
                  "    // If no numeric data, give a message",
                  "    if (labels.length === 0) {",
                  "        return { error: 'Missing numeric fields (speed/speedLimit) in response. Nothing to chart.' };",
                  "    }",
                  "",
                  "    // Build flag view models",
                  "    const flagModels = [];",
                  "",
                  "    // online",
                  "    const onlineMeta = coerceBoolean(flags && Object.prototype.hasOwnProperty.call(flags, 'online') ? flags.online : undefined);",
                  "    flagModels.push({",
                  "        label: 'online',",
                  "        isBoolean: true,",
                  "        valueText: onlineMeta.text,",
                  "        colorBg: onlineMeta.bg,",
                  "        colorBorder: onlineMeta.border,",
                  "        colorText: onlineMeta.textColor",
                  "    });",
                  "",
                  "    // overspeed",
                  "    const overspeedMeta = coerceBoolean(flags && Object.prototype.hasOwnProperty.call(flags, 'overspeed') ? flags.overspeed : undefined);",
                  "    flagModels.push({",
                  "        label: 'overspeed',",
                  "        isBoolean: true,",
                  "        valueText: overspeedMeta.text,",
                  "        colorBg: overspeedMeta.bg,",
                  "        colorBorder: overspeedMeta.border,",
                  "        colorText: overspeedMeta.textColor",
                  "    });",
                  "",
                  "    // gpsOk",
                  "    const gpsOkMeta = coerceBoolean(flags && Object.prototype.hasOwnProperty.call(flags, 'gpsOk') ? flags.gpsOk : undefined);",
                  "    flagModels.push({",
                  "        label: 'gpsOk',",
                  "        isBoolean: true,",
                  "        valueText: gpsOkMeta.text,",
                  "        colorBg: gpsOkMeta.bg,",
                  "        colorBorder: gpsOkMeta.border,",
                  "        colorText: gpsOkMeta.textColor",
                  "    });",
                  "",
                  "    // speedLimit as numeric bar (secondary indicator)",
                  "    if (speedLimitFromFlags !== null) {",
                  "        const maxForBar = Math.max(1, speedLimitFromFlags);",
                  "        const percent = Math.max(0, Math.min(100, (speedLimitFromFlags / maxForBar) * 100));",
                  "        flagModels.push({",
                  "            label: 'speedLimit',",
                  "            isBoolean: false,",
                  "            percent: percent,",
                  "            rawValue: String(speedLimitFromFlags)",
                  "        });",
                  "    }",
                  "",
                  "    // speed as numeric bar",
                  "    if (speed !== null) {",
                  "        const maxForBar = Math.max(1, speedLimitFromFlags !== null ? speedLimitFromFlags : Math.max(1, speed));",
                  "        const percent = Math.max(0, Math.min(100, (speed / maxForBar) * 100));",
                  "        flagModels.push({",
                  "            label: 'speed',",
                  "            isBoolean: false,",
                  "            percent: percent,",
                  "            rawValue: String(speed)",
                  "        });",
                  "    }",
                  "",
                  "    return {",
                  "        vehicleId: vehicleId,",
                  "        flags: flagModels,",
                  "        chart: { labels: labels, values: values }",
                  "    };",
                  "}",
                  "",
                  "pm.visualizer.set(template, createPayload());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/vehicles/VH-JO-106/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles",
