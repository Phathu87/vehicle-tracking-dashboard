    {
      "name": "👨‍✈️ Driver Management",
      "item": [
        {
          "name": "Drivers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Visualization Script",
                  "// Visualization Script",
                  "const template = `",
                  "<div style=\"max-width: 700px; margin: 0 auto;\">",
                  "  <h3 style=\"text-align:center;\">Assigned Vehicles per Driver</h3>",
                  "  <canvas id=\"barChart\" height=\"300\"></canvas>",
                  "  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js\"></script>",
                  "  <script>",
                  "    pm.getData(function (err, data) {",
                  "      if (err || !data || !data.drivers) return;",
                  "      var ctx = document.getElementById('barChart').getContext('2d');",
                  "      var chart = new Chart(ctx, {",
                  "        type: 'bar',",
                  "        data: {",
                  "          labels: data.drivers.map(d => d.name),",
                  "          datasets: [{",
                  "            label: 'Number of Assigned Vehicles',",
                  "            data: data.drivers.map(d => d.assignedVehiclesCount),",
                  "            backgroundColor: 'rgba(54, 162, 235, 0.6)',",
                  "            borderColor: 'rgba(54, 162, 235, 1)',",
                  "            borderWidth: 1",
                  "          }]",
                  "        },",
                  "        options: {",
                  "          scales: {",
                  "            yAxes: [{",
                  "              ticks: {",
                  "                beginAtZero: true,",
                  "                precision: 0",
                  "              },",
                  "              scaleLabel: {",
                  "                display: true,",
                  "                labelString: 'Assigned Vehicles'",
                  "              }",
                  "            }],",
                  "            xAxes: [{",
                  "              scaleLabel: {",
                  "                display: true,",
                  "                labelString: 'Driver Name'",
                  "              }",
                  "            }]",
                  "          },",
                  "          legend: { display: false },",
                  "          responsive: true,",
                  "          maintainAspectRatio: false",
                  "        }",
                  "      });",
                  "    });",
                  "  <\\/script>",
                  "</div>`;",
                  "",
                  "function createPayload() {",
                  "  var drivers = pm.response.json();",
                  "  return {",
                  "    drivers: drivers.map(function(driver) {",
                  "      return {",
                  "        name: driver.name,",
                  "        assignedVehiclesCount: Array.isArray(driver.assignedVehicles) ? driver.assignedVehicles.length : 0",
                  "      };",
                  "    })",
                  "  };",
                  "}",
                  "pm.visualizer.set(template, createPayload());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
